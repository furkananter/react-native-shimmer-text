{
  "name": "react-native-shimmer-text",
  "version": "0.1.4",
  "description": "Cross‑platform Shimmer Text component for React Native (iOS/Android) and Web.",
  "license": "MIT",
  "author": "furkananter (https://github.com/furkananter)",
  "repository": {
    "type": "git",
    "url": "https://github.com/furkananter/react-native-shimmer-text.git"
  },
  "homepage": "https://github.com/furkananter/react-native-shimmer-text#readme",
  "bugs": {
    "url": "https://github.com/furkananter/react-native-shimmer-text/issues"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "react-native": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "sideEffects": false,
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "react-native": "./lib/module/index.js",
      "web": "./lib/module/index.web.js",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "types": "./lib/typescript/index.d.ts"
    }
  },
  "scripts": {
    "build": "bob build",
    "clean": "bob clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "prepublishOnly": "bob build"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  },
  "peerDependencies": {
    "@react-native-masked-view/masked-view": ">=0.3.0",
    "react": ">=16.8.0",
    "react-native": ">=0.72",
    "react-native-reanimated": ">=3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-native/babel-preset": "^0.81.4",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.4.0",
    "react": "19.1.0",
    "react-native": "^0.81.4",
    "react-native-builder-bob": "^0.41.0",
    "react-native-reanimated": "^4.1.0",
    "react-native-worklets": "^0.5.1",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.39.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "react-native",
    "expo",
    "shimmer",
    "text",
    "ios",
    "android",
    "web"
  ],
  "publishConfig": {
    "access": "public"
  }
}
